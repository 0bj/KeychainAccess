SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator appletvos appletvsimulator;
TARGETED_DEVICE_FAMILY = 1,2,3;
SUPPORTS_MACCATALYST = YES;

COPY_PHASE_STRIP = NO;
GENERATE_INFOPLIST_FILE = YES;
INFOPLIST_KEY_UILaunchScreen_Generation = YES;
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES;
MARKETING_VERSION = 1.0;
PRODUCT_NAME = $(TARGET_NAME);
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;
ASSETCATALOG_COMPILER_APPICON_NAME[sdk=appletv*] = ;

PRODUCT_BUNDLE_IDENTIFIER = io.github.0bj.KeychainAccess.TestHost;

// Keychain tests need a signed host. Set DEVELOPMENT_TEAM in Local.xcconfig (see Base.xcconfig).
CODE_SIGN_ENTITLEMENTS = TestHost/TestHost.entitlements;
CODE_SIGN_STYLE = Automatic;
CODE_SIGN_IDENTITY = Apple Development;

LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks @loader_path/Frameworks;
LD_RUNPATH_SEARCH_PATHS[sdk=appletv*] = $(inherited) @executable_path/Frameworks @loader_path/Frameworks;
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks;
